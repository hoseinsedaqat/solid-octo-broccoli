# ─────────────────────────────────────────────────────────────────────────────
# World War — متغیرهای محیط Vite (فقط apps/frontend)
# کپی کنید به .env.local در همان پوشه (اگر نیاز دارید مقدار پیش‌فرض را عوض کنید).
# ─────────────────────────────────────────────────────────────────────────────

# مقصد proxy در حالت توسعه: درخواست‌های /api و /bot به این آدرس فرستاده می‌شوند
# تا مرورگر فقط با یک origin حرف بزند (نیازی به CORS نیست).
# مقدار پیش‌فرض همان `wrangler dev` روی پورت ۸۷۸۷ است:
WW_API_TARGET=http://127.0.0.1:8787
