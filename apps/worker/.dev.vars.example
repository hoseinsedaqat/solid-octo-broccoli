# ─────────────────────────────────────────────────────────────────────────────
# World War — متغیرهای محیط Worker (Cloudflare)
# این فایل فقط الگوست؛ فایل واقعی را با نام .dev.vars در apps/worker بسازید
# (برای wrangler dev) و در پروداکشن از wrangler secret put استفاده کنید.
# هرگز مقدار واقعی را در گیت commit نکنید.
# ─────────────────────────────────────────────────────────────────────────────

# توکن ربات تلگرام (از @BotFather). تنها مقدار الزامی برای زنده‌شدن بازی.
BOT_TOKEN=123456789:REPLACE_WITH_REAL_TOKEN

# شناسه عددی تلگرام مدیران، جدا‌شده با کاما. اولین شناسه = مدیر اصلی (قابل حذف نیست).
# مدیر اصلی هنگام اولین /start admin خودش ساخته می‌شود؛ بقیه را می‌توان از پنل داد.
ADMIN_TELEGRAM_IDS=111111111

# رمز وب‌هوک: هم در setWebhook و هم در هدر x-telegram-bot-api-secret-token ست می‌شود.
# بدون آن، هر کسی که آدرس وب‌هوک را حدس بزند می‌تواند از طرف بازیکن‌ها آپدیت بفرستد.
TELEGRAM_WEBHOOK_SECRET=long-random-string-change-me

# رندوم ۳۲+ بایت؛ برای هش توکن‌های سشن استفاده می‌شود (sha256 در جدول sessions).
APP_SECRET=another-long-random-string

# development | test | local → مسیر کمکی /api/auth/dev-login فعال می‌شود (فقط برای توسعه!).
# هر مقدار دیگر (از جمله خالی) = production و dev-login با 403 بسته می‌شود.
APP_ENV=development

# آدرس عمومی Worker (برای لینک‌های ربات). خالی بگذارید اگر مینی‌اپ از همان origin سرو می‌شود.
PUBLIC_BASE_URL=

# اگر مینی‌اپ روی دامنه‌ای جدا (مثلاً Pages) میزبانی می‌شود، آدرس کامل آن:
WEBAPP_URL=

# فقط برای توسعه آفلاین / شبکه فیلترشده: آدرس پیاده‌سازی محلی Bot API.
# با `node scripts/telegram-stub.mjs` روی پورت ۹۹۹۹ یک ضبط‌کننده آفلاین بالا می‌آید.
TELEGRAM_API_BASE=http://127.0.0.1:9999

# هر مقدار غیرخالی = کران ۳۰ دقیقه‌ای غیرفعال (برای دیباگ دستی مفید است).
CRON_DISABLED=
